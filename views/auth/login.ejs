<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title><%= title %></title>

    <link rel="preconnect" href="https://fonts.googleapis.com">

    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;700&display=swap"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="/css/global.css"
    >

    <link
        rel="stylesheet"
        href="/css/login.css"
    >

</head>

<body>

    <main class="login-page container">

        <section class="login-panel">

            <form
                class="login-form"
                action="/auth/login"
                method="POST"
                novalidate
            >

                <h2>Login</h2>

                <% if (errors.length) { %>

                    <div class="errors">

                        <% errors.forEach(error => { %>

                            <p><%= error.msg %></p>

                        <% }) %>

                    </div>

                <% } %>

                <div class="login-field">

                    <label for="username">
                        Username
                    </label>

                    <input
                        id="username"
                        type="text"
                        name="username"
                        value="<%= oldInput.username || '' %>"
                    >

                </div>

                <div class="login-field">

                    <label for="password">
                        Password
                    </label>

                    <input
                        id="password"
                        type="password"
                        name="password"
                    >

                </div>

                <button
                    type="submit"
                    class="btn btn-primary login-submit"
                >
                    Login
                </button>

            </form>

        </section>

        <section class="login-brand">

            <h1 class="login-logo">
                Javedan<span>Drive</span>
            </h1>

            <p class="login-tagline">
                Secure cloud storage.<br>
                Built for creators.
            </p>

            <div class="login-oauth">

                <a
                    href="/auth/google"
                    class="btn"
                >
                    Continue with Google
                </a>

                <a
                    href="/auth/github"
                    class="btn"
                >
                    Continue with GitHub
                </a>

            </div>

            <p class="signup-link">

                Don't have an account?

                <a href="/auth/register">
                    Sign Up →
                </a>

            </p>

        </section>

    </main>

    <footer>

        © 2026 JavedanCode

    </footer>

</body>

</html>
<div
    class="modal hidden"
    id="share-folder-modal"
>

    <div class="modal-content">

        <button
            class="modal-close close-modal"
            type="button"
            aria-label="Close"
        >
            ×
        </button>

        <h2>

            Share Folder

        </h2>

        <form
            action="/folder/<%= currentFolder.id %>/share"
            method="POST"
        >

            <div class="field">

                <label for="share-duration">

                    Link Expiration

                </label>

                <select
                    id="share-duration"
                    name="duration"
                    required
                >

                    <option value="1d">

                        1 Day

                    </option>

                    <option value="7d">

                        7 Days

                    </option>

                    <option value="30d">

                        30 Days

                    </option>

                </select>

            </div>

            <% if (errors.length) { %>

                <div class="form-errors">

                    <% errors.forEach(error => { %>

                        <p><%= error.msg %></p>

                    <% }) %>

                </div>

            <% } %>

            <div class="modal-actions">

                <button
                    class="btn btn-secondary close-modal"
                    type="button"
                >
                    Cancel
                </button>

                <button
                    class="btn btn-primary"
                    type="submit"
                >
                    Generate Link
                </button>

            </div>

        </form>

    </div>

</div>
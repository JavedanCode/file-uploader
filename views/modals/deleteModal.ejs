<div class="modal hidden" id="delete-modal">
  <div class="modal-content">
    <button class="modal-close close-modal" type="button" aria-label="Close">
      ×
    </button>

    <h2 id="delete-title">Delete</h2>

    <p>
      Are you sure you want to delete

      <strong id="delete-name"></strong>?
    </p>

    <p class="delete-warning">This action cannot be undone.</p>

    <div class="modal-actions">
      <button class="btn btn-secondary close-modal" type="button">
        Cancel
      </button>

      <button class="btn btn-danger" id="confirm-delete" type="button">
        Delete
      </button>
    </div>
  </div>
</div>
